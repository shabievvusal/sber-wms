# Caddy — HTTPS для robops.ru и разводка запросов:
#  • /api/... на dotnet — пути перечислены блоками handle ниже;
#  • фото консолидации и РК — прямо с диска (тома node-persist, rk-photos);
#  • всё остальное (сам сайт и оставшиеся API) — на node.
# Новый маршрут dotnet нужно добавить сюда, иначе запрос уйдёт в node
# (а node на неизвестный /api/... отвечает 404).
# (app) — общие правила сайта, подключаются через `import app` в блок
# robops.ru внизу файла.
(app) {
	# Журнал каждого запроса (2026-09-13) — JSON в stdout контейнера, смотреть
	# `docker compose logs caddy`. Без него при недоступности сайта нельзя
	# было понять, доходили ли запросы до сервера вообще. Cookie Caddy сам
	# маскирует (REDACTED); ротация — logging в docker-compose.yml.
	log {
		output stdout
	}

	# Сжатие ответов (2026-09-13). Node сжимает сам (compression), а dotnet —
	# нет: вся статистика (/api/date/*, отчёты) шла несжатым JSON, что заметно
	# на медленном складском интернете. Уже сжатые ответы Node Caddy повторно
	# не трогает. Типы перечислены явно — картинки и видео не сжимаются.
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	handle /api/rk/* {
		reverse_proxy dotnet:5080
	}
	# фото РК и превью (/rk-photos/<имя>, /rk-photos/thumb/<имя>) — прямо с
	# диска (том rk-photos, пишет dotnet). Имена случайные — кэш на год.
	handle_path /rk-photos/* {
		root * /srv/rk-photos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /api/tsd-assignments* {
		reverse_proxy dotnet:5080
	}
	handle /api/tsd-settings* {
		reverse_proxy dotnet:5080
	}
	handle /api/tsd/manual-employees* {
		reverse_proxy dotnet:5080
	}
	handle /api/empl {
		reverse_proxy dotnet:5080
	}
	handle /api/empl/add-new {
		reverse_proxy dotnet:5080
	}
	# Проверка учёток ТСД (вход в wmsin-pdt), см. AccountCheckService.cs
	handle /api/empl/account-check* {
		reverse_proxy dotnet:5080
	}
	handle /api/employees {
		reverse_proxy dotnet:5080
	}
	handle /api/date/* {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/monthly-company {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/monthly-employees {
		reverse_proxy dotnet:5080
	}
	# «Поиск потеряшек» (2026-10-25) — переводы ЕО в ЗГЗ, см. ZgzEndpoints.cs
	# ЦФЗ по ячейкам КДК (2026-10-25), см. CellStoreEndpoints.cs
	handle /api/cell-stores* {
		reverse_proxy dotnet:5080
	}
	# фото жалоб «Консолидации» — прямо с диска (папка uploads тома node-persist),
	# Node их не касается. Имена файлов случайные, кэш браузера — на год.
	handle_path /api/consolidation/uploads/* {
		root * /srv/node-persist/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# служебное: «Обновлено», запрос обновления, автообновление, перекличка (SystemEndpoints.cs)
	handle /api/status {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/request-fetch {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/mark-updated {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/auto-fetch-settings {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/admin/auto-fetch-settings {
		reverse_proxy dotnet:5080
	}
	handle /api/rollcall {
		reverse_proxy dotnet:5080
	}
	# нарушения (видео до 500 МБ), исполнители без учётки, справочник товаров
	# WMS для раскладки КДК — ViolationEndpoints.cs, WmsProxyEndpoints.cs
	handle /api/violations* {
		reverse_proxy dotnet:5080
	}
	handle /violation-videos/* {
		reverse_proxy dotnet:5080
	}
	handle /api/empl/find-unregistered {
		reverse_proxy dotnet:5080
	}
	handle /api/wms/products-by-id {
		reverse_proxy dotnet:5080
	}
	handle /api/zgz/* {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/report/* {
		reverse_proxy dotnet:5080
	}
	# выработка сотрудник × смена — «Итоги смены» и нормы (2026-10-29)
	handle /api/stats/workload {
		reverse_proxy dotnet:5080
	}
	# расстановка товара по оборачиваемости (2026-10-29)
	handle /api/stats/slotting {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/receiving/period-rows {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/receiving/known {
		reverse_proxy dotnet:5080
	}
	# сохранение выгрузок WMS (тело до 300 МБ) — WmsSaveEndpoints.cs
	handle /api/save-fetched-data {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/stock-moves/save {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/placement/save {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/receiving/save {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/remains/save {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/shift-data/count* {
		reverse_proxy dotnet:5080
	}
	handle /api/stats/shift-data/delete* {
		reverse_proxy dotnet:5080
	}
	# веса товаров (админ): Excel, данные из WMS — ProductWeightsAdminEndpoints.cs
	handle /api/vs/admin/product-weights* {
		reverse_proxy dotnet:5080
	}
	# отчёт по РК, ящикам и ТЧ — ShipmentReportEndpoints.cs
	handle /api/shipments/report {
		reverse_proxy dotnet:5080
	}
	handle /api/product-weights {
		reverse_proxy dotnet:5080
	}
	handle /api/product-weights/missing {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/auth/* {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/admin/roles* {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/admin/pending* {
		reverse_proxy dotnet:5080
	}
	handle /api/vs/admin/users* {
		reverse_proxy dotnet:5080
	}
	# «Объединение остатков» (2026-07-27) — сравнение выгрузки остатков по МХ
	# (Excel) с выгрузкой задач комплектации (CSV), см.
	# backend-dotnet/Endpoints/StockConsolidationEndpoints.cs.
	handle /api/reports/stock-consolidation* {
		reverse_proxy dotnet:5080
	}
	# Мотивация аутсорса (2026-09-25) — учётки людей из актов и расчёт
	# часов по норме, см. backend-dotnet/Services/MotivationService.cs.
	handle /api/motivation/* {
		reverse_proxy dotnet:5080
	}
	handle {
		reverse_proxy node:3009
	}
}

# robops.ru (2026-09-13) — основной адрес. Caddy сам получает и продлевает
# сертификат Let's Encrypt (нужны открытые 80/443 и A-запись на сервер), а
# http:// перенаправляет на https:// автоматически. Домен нужен, чтобы при
# смене сервера менять одну DNS-запись, а не рассылать всем новый IP.
robops.ru {
	import app
}

www.robops.ru {
	redir https://robops.ru{uri} permanent
}

# Старый адрес http://<IP>:3009 убран (2026-09-13): сайт открывается только по
# домену. Порт 3009 больше не пробрасывается наружу (см. docker-compose.yml).
