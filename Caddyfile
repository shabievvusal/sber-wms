# Caddy — HTTPS для robops.ru и разводка запросов:
#  • /api/... и /violation-videos/... — dotnet (единственный бэкенд с 2026-10-31,
#    node убран; неизвестный /api/... dotnet отвечает 404 в JSON);
#  • фото консолидации и РК — прямо с диска (тома node-persist, rk-photos);
#  • всё остальное — сам сайт: собранный фронтенд в /srv/site (кладётся в
#    образ Caddy при сборке, см. Dockerfile).
# Все блоки — handle: из них срабатывает один, с самым длинным путём.
# (app) — общие правила сайта, подключаются через `import app` в блок
# robops.ru внизу файла.
(app) {
	# Журнал каждого запроса (2026-09-13) — JSON в stdout контейнера, смотреть
	# `docker compose logs caddy`. Без него при недоступности сайта нельзя
	# было понять, доходили ли запросы до сервера вообще. Cookie Caddy сам
	# маскирует (REDACTED); ротация — logging в docker-compose.yml.
	log {
		output stdout
	}

	# Сжатие ответов (2026-09-13): dotnet сам не сжимает — вся статистика
	# (/api/date/*, отчёты) шла бы несжатым JSON, что заметно на медленном
	# складском интернете. Типы перечислены явно — картинки и видео не сжимаются.
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	# фото жалоб «Консолидации» — с диска (папка uploads тома node-persist,
	# пишет dotnet). Имена файлов случайные — кэш браузера на год.
	handle /api/consolidation/uploads/* {
		uri strip_prefix /api/consolidation/uploads
		root * /srv/node-persist/uploads
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# фото РК и превью (/rk-photos/<имя>, /rk-photos/thumb/<имя>) — с диска
	# (том rk-photos, пишет dotnet). Имена случайные — кэш на год.
	handle /rk-photos/* {
		uri strip_prefix /rk-photos
		root * /srv/rk-photos
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy dotnet:5080
	}
	# видео «Нарушений» (с перемоткой, только со входом) — ViolationEndpoints.cs
	handle /violation-videos/* {
		reverse_proxy dotnet:5080
	}

	# Файлы сборки Vite в /assets/ содержат хеш в имени (index-Ab12Cd.js) и
	# после сборки не меняются — кэш на год. Отсутствующий бандл — честный 404,
	# а не index.html (иначе браузер падал на разборе HTML как JS).
	handle /assets/* {
		root * /srv/site
		# годовой кэш — только существующим файлам, не ответу 404
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Остальное — сайт (одностраничное приложение): существующий файл или
	# index.html. no-cache — после выкатки браузер сразу получает новые бандлы.
	handle {
		root * /srv/site
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# robops.ru (2026-09-13) — основной адрес. Caddy сам получает и продлевает
# сертификат Let's Encrypt (нужны открытые 80/443 и A-запись на сервер), а
# http:// перенаправляет на https:// автоматически. Домен нужен, чтобы при
# смене сервера менять одну DNS-запись, а не рассылать всем новый IP.
robops.ru {
	import app
}

www.robops.ru {
	redir https://robops.ru{uri} permanent
}

# Старый адрес http://<IP>:3009 убран (2026-09-13): сайт открывается только по
# домену. Порт 3009 больше не пробрасывается наружу (см. docker-compose.yml).
