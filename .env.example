# Порт приложения (по умолчанию 3001 — чтобы не конфликтовать с другим проектом на 3000)
PORT=3007

# Агент ноды — для связи с панелью управления
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_TOKEN=your_random_secret_here
NODE_NAME=Нода

# PostgreSQL — единственное хранилище (режим JSON-файлов убран)
PG_HOST=postgres
PG_PORT=5432
PG_DB=zlp
PG_USER=zlp
PG_PASSWORD=your_pg_password_here


# Роль «Разработчик» — номера телефонов (или буквенные логины) через запятую.
# Через Настройки эту роль выдать нельзя. После изменения: docker compose up -d dotnet
VS_DEVELOPER_LOGINS=
